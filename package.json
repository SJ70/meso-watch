{
  "name": "meso-watch",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mesowatch.app",
    "productName": "메소워치",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/meso.png",
      "requestedExecutionLevel": "requireAdministrator"
    }
  },
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
