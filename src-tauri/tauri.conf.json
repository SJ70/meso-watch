{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "메소워치",
  "mainBinaryName": "meso-watch",
  "version": "../package.json",
  "identifier": "com.mesowatch.app",
  "build": {
    "frontendDist": "../dist-app",
    "beforeDevCommand": "node scripts/stage-frontend.js",
    "beforeBuildCommand": "node scripts/stage-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SJ70",
    "copyright": "© 2026 SJ70",
    "license": "GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
